# Minimal OpenSBI generic-platform configuration for SimpleCPU.
#
# Keep only the FDT drivers backed by RTL in simplecpu.dts.  In particular,
# avoid the upstream generic defconfig's many unrelated platform overrides and
# peripheral drivers: every one of those probes the FDT during cold boot.

CONFIG_PLATFORM_GENERIC=y

CONFIG_FDT_SERIAL=y
CONFIG_FDT_SERIAL_UART8250=y

CONFIG_FDT_TIMER=y
CONFIG_FDT_TIMER_MTIMER=y

CONFIG_FDT_IPI=y
CONFIG_FDT_IPI_MSWI=y

CONFIG_FDT_IRQCHIP=y
CONFIG_FDT_IRQCHIP_PLIC=y

# Linux uses TIME/RFENCE/IPI/HSM/SRST.  Keep the legacy and debug-console
# interfaces as inexpensive compatibility aids, but omit unrelated extensions.
CONFIG_SBI_ECALL_TIME=y
CONFIG_SBI_ECALL_RFENCE=y
CONFIG_SBI_ECALL_IPI=y
CONFIG_SBI_ECALL_HSM=y
CONFIG_SBI_ECALL_SRST=y
CONFIG_SBI_ECALL_DBCN=y
CONFIG_SBI_ECALL_LEGACY=y

# CONFIG_SBI_ECALL_SUSP is not set
# CONFIG_SBI_ECALL_PMU is not set
# CONFIG_SBI_ECALL_CPPC is not set
# CONFIG_SBI_ECALL_FWFT is not set
# CONFIG_SBI_ECALL_VENDOR is not set
# CONFIG_SBI_ECALL_DBTR is not set
# CONFIG_SBI_ECALL_SSE is not set
# CONFIG_SBI_ECALL_MPXY is not set

# CONFIG_SERIAL_SEMIHOSTING is not set
